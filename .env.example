NEBIUS_API_KEY=your_nebius_token_factory_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
NEMOTRON_TRANSLATOR_MODEL=
NEMOTRON_REVIEWER_MODEL=
NEMOTRON_FIXER_MODEL=
NEMOTRON_VERIFIER_MODEL=
NEMOTRON_MAX_TOKENS=8192
PORT=8000
CUDAIFY_DB_PATH=cudaify.db

# CORS allowed origins (comma-separated). Empty = fail closed (production safe).
# Set to "*" for local development only.
CORS_ALLOWED_ORIGINS=

# Optional: Tavily key enables docs-grounded review (NVIDIA CUDA docs excerpts).
# Free tier: https://tavily.com
TAVILY_API_KEY=
